rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function libraryData(libId) {
      return get(/databases/$(database)/documents/libraries/$(libId)).data;
    }
    function isMemberOf(lib) { return uid() in lib.members; }
    // Old libraries have no editors list; the owner always counts
    function isEditorOf(lib) { return uid() == lib.ownerId || uid() in lib.get('editors', []); }

    // An accepted friendship with [other]. The friendship id is the two
    // uids sorted, so it can be looked up directly.
    function isFriendOf(other) {
      let pair = other < uid() ? other + '_' + uid() : uid() + '_' + other;
      let f = /databases/$(database)/documents/friendships/$(pair);
      return signedIn() && exists(f) && get(f).data.status == 'accepted';
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if signedIn();                    // search, member lists
      // Every signed-in user can read this doc, so it must never hold an email
      allow create: if uid() == userId && !('email' in request.resource.data);
      allow update: if uid() == userId && !('email' in request.resource.data);
      allow delete: if false;

      match /readingLogs/{readingKey} {
        // Friends see started and ended books, never want to read. Their
        // queries must filter on status for this to pass.
        allow read: if uid() == userId
          || (isFriendOf(userId)
              && resource.data.status in ['reading', 'paused', 'finished', 'dnf']);
        allow delete: if uid() == userId;
        // Rating and review live in ratings/, so friends who can read logs
        // later never see them
        allow create, update: if uid() == userId
          && !('rating' in request.resource.data)
          && !('review' in request.resource.data);
        match /reads/{readId} {
          allow read, write: if uid() == userId;
        }
      }

      // Rating and review for one book, keyed by readingKey. Owner only,
      // whatever friends can read on readingLogs later.
      match /ratings/{readingKey} {
        allow read, write: if uid() == userId;
      }

      // Started and finished events for the friends feed, id {readId}_{type}.
      // Written with the status change, deleted when it's undone.
      match /activity/{activityId} {
        allow read: if uid() == userId || isFriendOf(userId);
        allow create, update: if uid() == userId
          && request.resource.data.keys().hasOnly(
               ['type', 'readingKey', 'title', 'coverUrl', 'at'])
          && request.resource.data.type in ['started', 'finished']
          && activityId.matches('.+_' + request.resource.data.type)
          && request.resource.data.readingKey is string
          && request.resource.data.title is string
          && request.resource.data.at == request.time;
        allow delete: if uid() == userId;
      }
    }

    // Reading stats: collectionGroup('reads').where('uid', ==, me)
    match /{path=**}/reads/{readId} {
      allow read: if signedIn() && resource.data.uid == uid();
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if request.resource.data.uid == uid();
      allow delete: if resource.data.uid == uid();
      allow update: if false;
    }

    // ---------- Libraries ----------
    match /libraries/{libId} {
      function inviteFor(u) {
        return /databases/$(database)/documents/invites/$(libId + '_' + u);
      }

      // resource == null: a deleted library reads as missing instead of failing
      allow read: if signedIn() && (resource == null || isMemberOf(resource.data));

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.editors == [uid()]
        && request.resource.data.bookCount == 0
        && request.resource.data.uniqueCount == 0;

      allow update: if signedIn() && (
        // Owner: anything except ownership, and can't drop themselves
        (uid() == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId
          && uid() in request.resource.data.members)

        // Editors: only the counts, when adding or removing books
        || (isEditorOf(resource.data)
          && changed().hasOnly(['bookCount', 'uniqueCount', 'updatedAt']))

        // A member leaving (removes only themselves)
        || (uid() != resource.data.ownerId
          && changed().hasOnly(['members', 'editors', 'updatedAt'])
          && request.resource.data.members.toSet()
               == resource.data.members.toSet().difference([uid()].toSet())
          && !(uid() in request.resource.data.get('editors', [])))

        // Accepting an invite (adds only themselves, in the same batch)
        || (changed().hasOnly(['members'])
          && request.resource.data.members.toSet()
               == resource.data.members.toSet().union([uid()].toSet())
          && get(inviteFor(uid())).data.toUid == uid()
          && get(inviteFor(uid())).data.status == 'pending'
          && getAfter(inviteFor(uid())).data.status == 'accepted')
      );

      allow delete: if signedIn() && uid() == resource.data.ownerId;

      match /books/{bookId} {
        allow read: if signedIn() && isMemberOf(libraryData(libId));

        // Copies on loan can never be more than the copies owned
        allow create, update: if signedIn()
          && isEditorOf(libraryData(libId))
          && request.resource.data.get('lentCount', 0) >= 0
          && request.resource.data.get('lentCount', 0)
               <= request.resource.data.get('noOfCopies', 1);

        // A lent book can't be deleted, except by the owner (library delete),
        // or when its only copy is lost (markLost). Rules can't see the loan
        // here, so that last case trusts the editor.
        allow delete: if signedIn()
          && isEditorOf(libraryData(libId))
          && (resource.data.get('lentCount', 0) == 0
              || uid() == libraryData(libId).ownerId
              || (resource.data.get('noOfCopies', 1) == 1
                  && resource.data.get('lentCount', 0) == 1));
      }
    }

    // ---------- Invites ----------
    match /invites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.toUid == uid() || resource.data.fromUid == uid());

      // The owner sends (set() also re-sends over an old invite)
      allow create, update: if signedIn()
        && request.resource.data.fromUid == uid()
        && inviteId == request.resource.data.libraryId + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && uid() == libraryData(request.resource.data.libraryId).ownerId;

      // The invitee answers once
      allow update: if signedIn()
        && resource.data.toUid == uid()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && changed().hasOnly(['status', 'respondedAt']);

      allow delete: if false;
    }

    // ---------- Loans ----------
    match /loans/{loanId} {
      function isBorrower() { return resource.data.borrowerId == uid(); }
      function isManager() { return isEditorOf(libraryData(resource.data.libraryId)); }
      function wasIn(s) { return resource.data.status in s; }
      function becomes(s) { return request.resource.data.status == s; }
      function only(keys) { return changed().hasOnly(keys); }

      // The book's lentCount moves by the same amount in this transaction
      function lentCountMoves(by) {
        let p = /databases/$(database)/documents/libraries/$(resource.data.libraryId)/books/$(resource.data.bookId);
        return getAfter(p).data.get('lentCount', 0) == get(p).data.get('lentCount', 0) + by;
      }

      // On create: the book's lentCount goes up by one in this transaction
      function newLoanTakesCopy() {
        let p = /databases/$(database)/documents/libraries/$(request.resource.data.libraryId)/books/$(request.resource.data.bookId);
        return getAfter(p).data.get('lentCount', 0) == get(p).data.get('lentCount', 0) + 1;
      }

      function loanKeys() {
        return [
          'libraryId', 'bookId', 'ownerId', 'borrowerId', 'status',
          'bookTitle', 'coverUrl', 'borrowerName', 'libraryName',
          'requestedOn', 'respondedOn', 'lentOn', 'collectOn', 'dueOn',
          'returnedOn', 'requestNote', 'responseNote'];
      }

      // A lost copy leaves the library: one copy fewer (lent and owned),
      // the book deleted when it was the last one, or it was already gone
      function copyLost() {
        let p = /databases/$(database)/documents/libraries/$(resource.data.libraryId)/books/$(resource.data.bookId);
        return !exists(p)
          || !existsAfter(p)
          || (getAfter(p).data.get('lentCount', 0) == get(p).data.get('lentCount', 0) - 1
              && getAfter(p).data.get('noOfCopies', 1) == get(p).data.get('noOfCopies', 1) - 1);
      }

      // Optional dates, today or later, and return after collect
      function validRequestDates() {
        let d = request.resource.data;
        let yesterday = request.time - duration.value(1, 'd');
        let collect = d.get('collectOn', null);
        let due = d.get('dueOn', null);
        return (collect == null || (collect is timestamp && collect > yesterday))
          && (due == null || (due is timestamp && due > yesterday))
          && (collect == null || due == null || due > collect);
      }

      // A viewer of the library (not an editor) asking for a book that exists
      function validRequestLibrary() {
        let d = request.resource.data;
        let lib = libraryData(d.libraryId);
        return isMemberOf(lib) && !isEditorOf(lib)
          && d.ownerId == lib.ownerId
          && exists(/databases/$(database)/documents/libraries/$(d.libraryId)/books/$(d.bookId));
      }

      allow read: if signedIn() && (isBorrower() || isManager());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(loanKeys())
        && request.resource.data.borrowerId == uid()
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedOn is timestamp
        && request.resource.data.get('respondedOn', null) == null
        && request.resource.data.get('lentOn', null) == null
        && request.resource.data.get('returnedOn', null) == null
        && request.resource.data.get('responseNote', null) == null
        && validRequestDates()
        && validRequestLibrary();

      // Lent on today or earlier (a loan from before the app), and returned
      // after it was lent, so an old loan can already be overdue. The hour
      // of slack covers a phone clock running fast.
      function validManualDates() {
        let d = request.resource.data;
        let due = d.get('dueOn', null);
        return d.lentOn is timestamp
          && d.lentOn <= request.time + duration.value(1, 'h')
          && d.get('collectOn', null) == null
          && (due == null || (due is timestamp && due > d.lentOn));
      }

      // Someone typed in by name, or an app user other than the editor
      function validManualBorrower() {
        let id = request.resource.data.borrowerId;
        return id == ''
          || (id is string && id != uid()
              && exists(/databases/$(database)/documents/users/$(id)));
      }

      // An editor recording a loan made outside the app: starts as lent
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(loanKeys())
        && validManualBorrower()
        && request.resource.data.borrowerName is string
        && request.resource.data.borrowerName.size() > 0
        && request.resource.data.status == 'lent'
        && request.resource.data.requestedOn is timestamp
        && request.resource.data.get('respondedOn', null) == null
        && request.resource.data.get('returnedOn', null) == null
        && validManualDates()
        && request.resource.data.ownerId == libraryData(request.resource.data.libraryId).ownerId
        && isEditorOf(libraryData(request.resource.data.libraryId))
        && newLoanTakesCopy();

      // Borrower withdraws before the handover
      allow update: if signedIn() && isBorrower()
        && wasIn(['requested', 'approved']) && becomes('cancelled')
        && only(['status']);

      // Editors move it along
      allow update: if signedIn() && isManager() && (
        (wasIn(['requested']) && becomes('approved')
          && only(['status', 'respondedOn', 'dueOn', 'responseNote']))
        || (wasIn(['requested', 'approved']) && becomes('rejected')
          && only(['status', 'respondedOn', 'responseNote']))
        || (wasIn(['approved']) && becomes('lent')
          && only(['status', 'lentOn', 'dueOn']) && lentCountMoves(1))
        || (wasIn(['lent']) && becomes('returned')
          && only(['status', 'returnedOn']) && lentCountMoves(-1))
        || (wasIn(['lent']) && becomes('lost')
          && only(['status', 'returnedOn']) && copyLost())
        // Change due date
        || (wasIn(['approved', 'lent']) && only(['dueOn']))
      );

      allow delete: if false;
    }

    // ---------- Friendships ----------
    // One doc per pair, id is the two uids sorted and joined with '_'
    match /friendships/{friendshipId} {
      function userDoc(u) { return get(/databases/$(database)/documents/users/$(u)).data; }

      function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

      // resource == null: sendRequest reads the doc before it exists
      allow read: if signedIn()
        && (resource == null || uid() in resource.data.uids);

      // The sender asks; usernames must match the real profiles
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'uids', 'fromUid', 'fromUsername', 'toUid', 'toUsername',
             'status', 'createdAt', 'respondedAt'])
        && request.resource.data.fromUid == uid()
        && request.resource.data.toUid != uid()
        && request.resource.data.uids == [uid(), request.resource.data.toUid]
        && friendshipId == pairId(uid(), request.resource.data.toUid)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.get('respondedAt', null) == null
        && request.resource.data.fromUsername == userDoc(uid()).username
        && request.resource.data.toUsername == userDoc(request.resource.data.toUid).username;

      // Only the person asked can accept, once
      allow update: if signedIn()
        && resource.data.toUid == uid()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.respondedAt == request.time
        && changed().hasOnly(['status', 'respondedAt']);

      // Decline, cancel and unfriend
      allow delete: if signedIn() && uid() in resource.data.uids;
    }
  }
}
